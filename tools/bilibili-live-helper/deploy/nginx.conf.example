# Load this file inside nginx's http block. Replace the three signer.example.com references.
limit_req_zone $binary_remote_addr zone=dango_start:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=dango_session:10m rate=120r/m;

server {
    listen 443 ssl;
    server_name signer.example.com;
    ssl_certificate /etc/letsencrypt/live/signer.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/signer.example.com/privkey.pem;

    access_log off;
    client_max_body_size 4k;
    client_body_timeout 5s;
    limit_req_status 429;
    proxy_set_header Host 127.0.0.1:19754;
    proxy_connect_timeout 2s;
    proxy_read_timeout 18s;

    location = /start {
        limit_req zone=dango_start burst=4 nodelay;
        proxy_pass http://127.0.0.1:19754;
    }

    location ~ ^/(heartbeat|end)$ {
        limit_req zone=dango_session burst=16 nodelay;
        proxy_pass http://127.0.0.1:19754;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:19754;
    }

    location / {
        return 404;
    }
}
